[Unit]
Description=Content Studio FastAPI backend
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
User=yyrm
Group=yyrm
WorkingDirectory=/www/wwwroot/content-studio/backend
ExecStart=/www/wwwroot/content-studio/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
